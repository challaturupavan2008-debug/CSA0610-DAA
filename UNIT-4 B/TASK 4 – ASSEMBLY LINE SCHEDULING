
# Assembly Line Scheduling using Dynamic Programming

# Processing times
a1 = [7, 9, 3, 4]
a2 = [8, 5, 6, 4]

# Transfer times
t1 = [2, 3, 1]
t2 = [2, 1, 2]

# Entry times
e1 = 2
e2 = 4

# Exit times
x1 = 3
x2 = 2

n = len(a1)

# DP arrays
f1 = [0] * n
f2 = [0] * n

# First station
f1[0] = e1 + a1[0]
f2[0] = e2 + a2[0]

# Calculate minimum time
for j in range(1, n):

    f1[j] = min(
        f1[j - 1] + a1[j],
        f2[j - 1] + t2[j - 1] + a1[j]
    )

    f2[j] = min(
        f2[j - 1] + a2[j],
        f1[j - 1] + t1[j - 1] + a2[j]
    )

# Final minimum time
result = min(
    f1[n - 1] + x1,
    f2[n - 1] + x2
)

print("Line 1 DP:", f1)
print("Line 2 DP:", f2)

print("Minimum Production Time:", result)

