
def next_fit(workloads, capacity):

    servers = []
    remaining = []

    for workload in workloads:

        if workload > capacity or workload <= 0:
            raise ValueError("Invalid workload")

        if not servers or remaining[-1] < workload:

            servers.append([workload])
            remaining.append(capacity - workload)

        else:

            servers[-1].append(workload)
            remaining[-1] -= workload

    print("Total Servers Used:", len(servers))

    for i in range(len(servers)):

        print("Server", i + 1)
        print("Workloads:", servers[i])
        print("Remaining Capacity:", remaining[i])


# Input

workloads = [6, 5, 5, 4, 4, 6]
capacity = 10

next_fit(workloads, capacity)

